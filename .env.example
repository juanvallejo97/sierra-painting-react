# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
#
# SECURITY NOTES:
# - Never commit .env files to git (they should be in .gitignore)
# - All VITE_* variables are embedded in the client bundle (publicly visible)
# - Never put secrets in VITE_* variables (use server-side env vars instead)
# - Firebase config values are safe to expose (protected by Security Rules)
# - Production values should use HTTPS endpoints only
#
# =============================================================================

# Firebase Configuration
# Get these values from Firebase Console > Project Settings
# Note: These are safe to expose publicly - security is enforced by Firestore Rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Environment
VITE_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5001/api

# Firebase Emulators (for local development)
# Set to 'true' to use local emulators instead of cloud Firebase
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Feature Flags
VITE_FEATURE_ESTIMATES=true
VITE_FEATURE_TIME_TRACKING=true
VITE_FEATURE_SCHEDULING=true
VITE_FEATURE_ANALYTICS=true

# Monitoring & Analytics
# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Debug Mode
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Firebase App Check (Protects against bot abuse)
# Get reCAPTCHA v3 site key from: https://console.cloud.google.com/security/recaptcha
# Register domains: localhost (dev), your-domain.com (prod)
VITE_RECAPTCHA_SITE_KEY=
# Debug token for local development (get from Firebase Console > App Check > Apps)
VITE_APPCHECK_DEBUG_TOKEN=