{
  "name": "sierra-painting-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:emulator": "vitest --run --config vitest.emulator.config.ts",
    "test:emulator:watch": "vitest --config vitest.emulator.config.ts",
    "test:emulator:coverage": "vitest --coverage --config vitest.emulator.config.ts",
    "test:rules": "vitest --run src/__tests__/firestore-rules.test.ts",
    "test:rules:coverage": "./scripts/check-rules-coverage.sh",
    "test:all": "npm run test -- --run && npm run test:emulator",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:smoke": "playwright test e2e/smoke",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps",
    "type-check": "tsc --noEmit",
    "size": "npm run build && size-limit",
    "size:why": "npm run build && size-limit --why",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test -- --run",
    "prepare": "husky",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "emulators": "firebase emulators:start",
    "emulators:start": "./scripts/emulator-manager.sh start",
    "emulators:stop": "./scripts/emulator-manager.sh stop",
    "emulators:restart": "./scripts/emulator-manager.sh restart",
    "emulators:status": "./scripts/emulator-manager.sh status",
    "emulators:clear": "./scripts/emulator-manager.sh clear",
    "load:test": "k6 run load-tests/staging.js",
    "load:test:staging": "BASE_URL=https://staging.sierra-painting.com k6 run load-tests/staging.js",
    "deploy:staging": "./scripts/deployment/deploy-staging.sh",
    "smoke:staging": "PLAYWRIGHT_BASE_URL=https://staging.sierra-painting.com npm run test:e2e:smoke",
    "size:check": "npm run size || exit 0",
    "coverage:check": "npm run test:coverage -- --run | grep 'All files' | awk '{if ($4+0 < 75) exit 1}'",
    "security:scan": "npm audit --audit-level=moderate",
    "a11y:check": "npm run test:e2e -- e2e/__tests__/accessibility",
    "emulators:export": "firebase emulators:export ./firebase-data",
    "emulators:import": "firebase emulators:start --import=./firebase-data"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.20.0",
    "@sentry/vite-plugin": "^4.4.0",
    "@tanstack/query-sync-storage-persister": "^5.90.7",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-persist-client": "^5.90.7",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.4.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@size-limit/preset-app": "^11.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^14.20.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "k6": "^0.0.0",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.18",
    "terser": "^5.44.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
